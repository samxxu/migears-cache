{
    "name": "migears/cache",
    "description": "A lightweight cache abstraction layer with PSR-16 compliance and Redis implementation",
    "type": "library",
    "license": "MIT",
    "version": "2.0.0",
    "require": {
        "php": "^8.1",
        "psr/simple-cache": "^3.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "suggest": {
        "ext-redis": "Required to use RedisCache implementation"
    },
    "provide": {
        "psr/simple-cache-implementation": "3.0"
    },
    "autoload": {
        "psr-4": {
            "MiGears\\Cache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MiGears\\Cache\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
